# Constrained NL2Cypher for BIM
# Environment Variables Template
# Copy this file to .env and fill in your values

# =============================================================================
# Neo4j Configuration
# =============================================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# =============================================================================
# LLM Configuration
# =============================================================================
# Provider: 'local', 'gemini', or 'openai'
LLM_PROVIDER=gemini

# API Key for cloud providers (required for gemini/openai)
LLM_API_KEY=your-api-key-here

# Model name or local path
# Examples:
#   - gemini-1.5-pro (for Gemini)
#   - gpt-4-turbo (for OpenAI)
#   - /path/to/local/model (for local models) example: bartowski/Qwen2.5-Coder-3B-Instruct-GGUF/Qwen2.5-Coder-3B-Instruct-Q4_K_M.gguf
LLM_MODEL_NAME=gemini-1.5-pro

# if openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1


# =============================================================================
# File Paths (inside container)
# =============================================================================
IFC_FILE_PATH=/app/data/model.ifc
IDS_FILE_PATH=/app/data/requirements.ids

# =============================================================================
# Application Settings
# =============================================================================
DEBUG=false
LOG_LEVEL=INFO
